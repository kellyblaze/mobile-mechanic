{
  "name": "mobile-mechanic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/check-migrations.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "generate:client": "tsx packages/contracts/scripts/generate-client.ts",
    "api:mock": "MOCK_MODE=true tsx apps/api/src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "fastify": "^5.4.0",
    "fastify-raw-body": "^5.0.0",
    "pg": "^8.16.3",
    "jose": "^6.1.0",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^16.6.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
